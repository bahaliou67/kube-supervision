{
  "name": "kube-supervision",
  "version": "0.1.0",
  "description": "Supervision et diagnostic d'un cluster Kubernetes depuis le navigateur, sans terminal",
  "keywords": [
    "kubernetes",
    "k8s",
    "supervision",
    "diagnostic",
    "logs",
    "pods",
    "dashboard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaliou67/kube-supervision.git"
  },
  "homepage": "https://bahaliou67.github.io/kube-supervision/",
  "bugs": {
    "url": "https://github.com/bahaliou67/kube-supervision/issues"
  },
  "type": "module",
  "bin": {
    "kube-supervision": "bin/kube-supervision.js"
  },
  "files": [
    "bin/",
    "backend/src/",
    "frontend/dist/",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node bin/kube-supervision.js",
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "build:exe": "node packaging/construire-executable.mjs",
    "test": "npm test --workspace backend && npm test --workspace frontend",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "express": "^5.2.1",
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
